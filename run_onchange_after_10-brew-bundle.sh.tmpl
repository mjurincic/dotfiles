#!/bin/bash
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
set -e
eval "$(/opt/homebrew/bin/brew shellenv)"
{{- if index . "ci" }}
# Headless test run: App Store apps need a signed-in Apple ID, so skip every `mas` line.
HOMEBREW_BUNDLE_MAS_SKIP="$(grep -oE '^mas .*id: *[0-9]+' {{ joinPath .chezmoi.sourceDir "Brewfile" | quote }} | grep -oE '[0-9]+$' | xargs)"
export HOMEBREW_BUNDLE_MAS_SKIP
{{- end }}
brew bundle --file={{ joinPath .chezmoi.sourceDir "Brewfile" | quote }}
