[user]
  name = {{ .name }}
  email = {{ .email }}
  # Refuse to commit with a guessed name/email (e.g. you@Mac.local)
  useConfigOnly = true
  # Sign commits with your personal SSH key (via 1Password)
  signingkey = ~/.ssh/github_personal.pub

[core]
  # Personal GitHub key by default; 1Password picks the private key matching this public key
  sshCommand = ssh -i ~/.ssh/github_personal.pub -o IdentitiesOnly=yes
  pager = delta
  autocrlf = input

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true

[gpg]
  format = ssh

[gpg "ssh"]
  # 1Password signs with the private key matching user.signingkey (Touch ID prompt)
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
  # Lets `git log --show-signature` verify your own commits locally
  allowedSignersFile = ~/.ssh/allowed_signers

[commit]
  gpgsign = true

[tag]
  gpgsign = true

[init]
  defaultBranch = main

[push]
  autoSetupRemote = true

{{- if .workEmail }}

# Repos under ~/work/ use the work email and work key
[includeIf "gitdir:~/work/"]
  path = ~/.gitconfig-work
{{- end }}
